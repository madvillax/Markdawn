---
// biome-ignore lint/correctness/noUnusedImports: Used by the Astro template below.
import { Image } from 'astro:assets';
// biome-ignore lint/correctness/noUnusedImports: Used by the Astro template below.
import human from '../assets/hero-human-retro.png';

// Official brand assets are stored locally; source URLs are in hero-assets.md.
// biome-ignore lint/correctness/noUnusedVariables: Used by the Astro template below.
const agents = [
  { name: 'Pi', icon: 'pi', x: 480, y: 55, branchX: 340 },
  { name: 'Cursor', icon: 'cursor', x: 490, y: 225, branchX: 350 },
  { name: 'ChatGPT', icon: 'chatgpt', x: 650, y: 55, branchX: 510 },
  { name: 'Claude', icon: 'claude', x: 830, y: 215, branchX: 665 },
  { name: 'OpenCode', icon: 'opencode', x: 650, y: 300, branchX: 480 },
  { name: 'Grok', icon: 'grok', x: 830, y: 55, branchX: 710 },
  { name: 'Antigravity', icon: 'antigravity', x: 1020, y: 250, branchX: 810 },
  { name: 'Muse (Meta)', icon: 'muse', x: 1010, y: 80, branchX: 880 },
];

// Flexible branches leave the shared axis with a smooth horizontal tangent.
// biome-ignore lint/correctness/noUnusedVariables: Used by the Astro template below.
const branchPath = (branchX: number, x: number, y: number): string => {
  return `M${branchX} 135 C${branchX + (x - branchX) * 0.4} 135 ${x - 85} ${y} ${x - 28} ${y}`;
};
---

<div class="collaboration-scene" data-agent-scene role="img" aria-label="A glowing blue thought travels from a human through flexible branches that orbit the shared axis. Eight agents generate responses in sequence, and the signal continues into the shared Markdown page.">
 <div class="collaboration-canvas">
  <Image class="human-figure" src={human} alt="" widths={[320, 640]} sizes="(max-width: 960px) 33vw, 317px" format="webp" quality={100} loading="eager" fetchpriority="high" />
  <svg class="agent-connections" viewBox="0 0 1100 360" fill="none" aria-hidden="true">
    <path class="connection-source" d="M241 105H270Q278 105 284 111L302 129Q308 135 316 135" />
    <path class="connection-trunk" d="M316 135H880" />
    {agents.map(({ branchX, x, y }, index) => (
      <g data-agent-branch={index} data-branch-x={branchX}>
        <path data-branch-path d={branchPath(branchX, x, y)} />
        <circle class="signal-halo" data-branch-halo r="8" />
        <circle class="signal-core" data-branch-signal r="2.5" />
      </g>
    ))}
    <rect class="connection-junction" x="312" y="131" width="8" height="8" rx="1" />
    <path class="signal-route" data-source-route d="M170 70Q208 70 241 105H270Q278 105 284 111L302 129Q308 135 316 135H880" />
    <circle class="signal-halo" data-source-halo r="10" />
    <circle class="signal-core" data-source-signal r="3" />
  </svg>
  {agents.map(({ name, icon, x, y }, index) => (
    <div class="agent-node" data-agent-node={index} data-agent-x={x} data-agent-y={y} style={`--agent-x:${x / 11}%;--agent-y:${y / 3.6}%`} aria-hidden="true">
     <div class="agent-orbit" data-agent-orbit>
      <div class="agent-generation" data-agent-card>
        <div class="generation-heading"><img src={`/agents/${icon}.svg`} width="10" height="10" alt="" /><span>{name}</span><i></i></div>
        <code data-agent-output>{['Thinking through the idea…', 'Reading your project…', 'Connecting the context…', 'Drafting the next step…', 'Updating the page…', 'Exploring another angle…', 'Checking the details…', 'Bringing it together…'][index]}</code>
      </div>
      <div class="agent-logo">
        <img src={`/agents/${icon}.svg`} width="36" height="36" alt="" loading="eager" />
      </div>
      <span>{name}</span>
     </div>
    </div>
  ))}
 </div>
</div>

<div class="hero-motion-controls"><button type="button" data-hero-pause aria-pressed="false">Pause animation</button></div>

<script>
  import { initializeHeroAnimation } from '../scripts/heroAnimation';
  let cleanup: (() => void) | undefined;
  const initialize = (): void => {
    cleanup?.();
    const scene = document.querySelector<HTMLElement>('[data-agent-scene]');
    if (scene) cleanup = initializeHeroAnimation(scene);
  };
  document.addEventListener('astro:page-load', initialize);
  document.addEventListener('astro:before-swap', () => cleanup?.());
</script>

<style>
  .collaboration-scene {
    position: relative;
    width: min(100%, 960px);
    padding-top: 64px;
    overflow: visible;
    color: var(--text);
  }

  .collaboration-canvas { position: relative; aspect-ratio: 1100 / 360; }
  .agent-orbit { position: relative; display: grid; justify-items: center; gap: clamp(4px, 0.7vw, 8px); }
  .hero-motion-controls { width: min(960px, calc(100% - 32px)); margin: 0 auto; text-align: right; }
  .hero-motion-controls button { padding: 5px 0; border: 0; background: transparent; color: var(--muted); cursor: pointer; font: 9px Geist, sans-serif; }
  .hero-motion-controls button:hover { color: var(--text); }
  @media (prefers-reduced-motion: reduce) { .hero-motion-controls { display: none; } }
  .agent-generation {
    position: absolute;
    bottom: calc(100% + 10px);
    width: clamp(82px, 11vw, 118px);
    min-height: 57px;
    padding: 8px;
    border: 1px solid color-mix(in srgb, #3b82f6 38%, var(--line));
    border-radius: 8px;
    background: var(--background);
    box-shadow: 0 4px 18px rgb(0 0 0 / 10%);
    opacity: 0;
    transform: translateY(6px) scale(0.96);
    transform-origin: bottom center;
    pointer-events: none;
  }
  .generation-heading { display: flex; align-items: center; gap: 4px; margin-bottom: 5px; }
  .generation-heading img { width: 12px; height: 12px; padding: 1px; border-radius: 2px; background: #fff; object-fit: contain; filter: none; }
  .generation-heading span { padding: 0; font-size: 7px; color: var(--text); }
  .generation-heading i { width: 4px; height: 4px; margin-left: auto; border-radius: 50%; background: #3b82f6; }
  .agent-generation code { display: block; min-height: 23px; color: var(--muted); font: 8px/1.45 'Geist Mono', monospace; white-space: pre-wrap; }
  .agent-generation code::after { content: ''; display: inline-block; width: 1px; height: 8px; margin-left: 2px; background: #3b82f6; }
  .signal-route { stroke: #60a5fa; stroke-width: 2.5; opacity: 0; filter: drop-shadow(0 0 4px #3b82f6) drop-shadow(0 0 8px #2563eb); }
  .signal-halo { fill: #3b82f6; stroke: none; opacity: 0; filter: blur(3px); }
  .signal-core { fill: #dbeafe; stroke: #60a5fa; stroke-width: 1; opacity: 0; filter: drop-shadow(0 0 4px #3b82f6) drop-shadow(0 0 9px #2563eb); }
  [data-branch-path].is-generating { filter: drop-shadow(0 0 3px rgb(59 130 246 / 65%)); }

  .collaboration-scene :global(.human-figure) {
    position: absolute;
    top: 0;
    left: 0;
    width: 33%;
    height: auto;
    filter: none;
    image-rendering: pixelated;
  }

  .agent-connections {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    stroke: color-mix(in srgb, var(--muted) 60%, var(--background));
    stroke-width: 1.2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .connection-source {
    stroke: var(--text);
    stroke-width: 2;
  }

  .connection-junction {
    fill: var(--text);
    stroke: none;
  }

  .agent-node {
    --agent-size: clamp(22px, 4vw, 44px);
    position: absolute;
    top: var(--agent-y);
    left: var(--agent-x);
    display: grid;
    justify-items: center;
    gap: clamp(4px, 0.7vw, 8px);
    transform: translate(-50%, calc(var(--agent-size) / -2));
  }

  .agent-logo {
    display: grid;
    width: var(--agent-size);
    height: var(--agent-size);
    place-items: center;
    border: 1px solid var(--line);
    border-radius: 10px;
    background: #ffffff;
  }

  .agent-logo img {
    display: block;
    width: 75%;
    height: 75%;
    object-fit: contain;
    filter: none;
  }

  .agent-orbit > span {
    padding: 2px 5px;
    background: var(--background);
    font-family: 'Geist Mono', monospace;
    font-size: clamp(6px, 0.9vw, 10px);
    line-height: 1.2;
    color: var(--muted);
    white-space: nowrap;
  }

  @media (max-width: 560px) {
    .collaboration-scene { padding-top: 54px; }
    .agent-generation { width: clamp(50px, 15vw, 74px); min-height: 47px; padding: 5px; bottom: calc(100% + 6px); }
    .agent-node:nth-last-child(-n+2) .agent-generation { right: 0; }
    .generation-heading span { font-size: 6px; }
    .agent-generation code { font-size: 6px; min-height: 18px; }
    .agent-logo { border-radius: 5px; }
    .agent-orbit > span { padding: 1px 2px; font-size: 6px; }
  }
</style>
