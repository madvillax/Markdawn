---
// biome-ignore lint/correctness/noUnusedImports: Used by the Astro template below.
import { Image } from 'astro:assets';
// biome-ignore lint/correctness/noUnusedImports: Used by the Astro template below.
import human from '../assets/hero-human-retro.png';

// Official brand assets are stored locally; source URLs are in hero-assets.md.
// biome-ignore lint/correctness/noUnusedVariables: Used by the Astro template below.
const agents = [
  { name: 'Pi', icon: 'pi', x: 480, y: 55, branchX: 340 },
  { name: 'Cursor', icon: 'cursor', x: 490, y: 225, branchX: 350 },
  { name: 'ChatGPT', icon: 'chatgpt', x: 650, y: 55, branchX: 510 },
  { name: 'Claude', icon: 'claude', x: 800, y: 215, branchX: 665 },
  { name: 'OpenCode', icon: 'opencode', x: 710, y: 300, branchX: 480 },
  { name: 'Grok', icon: 'grok', x: 830, y: 55, branchX: 710 },
  { name: 'Antigravity', icon: 'antigravity', x: 1020, y: 250, branchX: 810 },
  { name: 'Muse (Meta)', icon: 'muse', x: 1010, y: 80, branchX: 880 },
];

// All branches share a 45-degree diagonal and a horizontal approach.
// biome-ignore lint/correctness/noUnusedVariables: Used by the Astro template below.
const branchPath = (branchX: number, x: number, y: number): string => {
  const direction = y < 135 ? -1 : 1;
  const bendX = branchX + Math.abs(y - 135);
  return `M${branchX} 135 Q${branchX + 3} 135 ${branchX + 6} ${135 + direction * 6} L${bendX - 6} ${y - direction * 6} Q${bendX} ${y} ${bendX + 8} ${y} H${x - 28}`;
};
---

<div class="collaboration-scene" role="img" aria-label="A human connects through Metakip to Pi, Cursor, ChatGPT, Claude, OpenCode, Grok, Antigravity, and Muse agents">
  <Image class="human-figure" src={human} alt="" widths={[320, 640]} sizes="(max-width: 960px) 33vw, 317px" format="webp" quality={100} loading="eager" fetchpriority="high" />
  <svg class="agent-connections" viewBox="0 0 1100 360" fill="none" aria-hidden="true">
    <path class="connection-source" d="M241 105H270Q278 105 284 111L302 129Q308 135 316 135" />
    <path class="connection-trunk" d="M316 135H880" />
    {agents.map(({ branchX, x, y }) => <path d={branchPath(branchX, x, y)} />)}
    <rect class="connection-junction" x="312" y="131" width="8" height="8" rx="1" />
  </svg>
  {agents.map(({ name, icon, x, y }) => (
    <div class="agent-node" style={`--agent-x:${x / 11}%;--agent-y:${y / 3.6}%`} aria-hidden="true">
      <div class="agent-logo">
        <img src={`/agents/${icon}.svg`} width="36" height="36" alt="" loading="eager" />
      </div>
      <span>{name}</span>
    </div>
  ))}
</div>

<style>
  .collaboration-scene {
    position: relative;
    width: min(100%, 960px);
    aspect-ratio: 1100 / 360;
    overflow: hidden;
    color: var(--text);
  }

  .collaboration-scene :global(.human-figure) {
    position: absolute;
    top: 0;
    left: 0;
    width: 33%;
    height: auto;
    image-rendering: pixelated;
  }

  .agent-connections {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    stroke: color-mix(in srgb, var(--muted) 60%, var(--background));
    stroke-width: 1.2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .connection-source {
    stroke: #ff6b2b;
    stroke-width: 2;
  }

  .connection-junction {
    fill: #ff6b2b;
    stroke: none;
  }

  .agent-node {
    --agent-size: clamp(22px, 4vw, 44px);
    position: absolute;
    top: var(--agent-y);
    left: var(--agent-x);
    display: grid;
    justify-items: center;
    gap: clamp(4px, 0.7vw, 8px);
    transform: translate(-50%, calc(var(--agent-size) / -2));
  }

  .agent-logo {
    display: grid;
    width: var(--agent-size);
    height: var(--agent-size);
    place-items: center;
    border: 1px solid rgb(37 37 35 / 8%);
    border-radius: 10px;
    background: #f7f7f5;
  }

  .agent-logo img {
    display: block;
    width: 75%;
    height: 75%;
    object-fit: contain;
  }

  .agent-node span {
    padding: 2px 5px;
    background: var(--background);
    font-family: 'Geist Mono', monospace;
    font-size: clamp(6px, 0.9vw, 10px);
    line-height: 1.2;
    color: var(--muted);
    white-space: nowrap;
  }

  @media (max-width: 560px) {
    .agent-logo { border-radius: 5px; }
    .agent-node span { padding: 1px 2px; font-size: 6px; }
  }
</style>
